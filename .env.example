ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# アプリパスワード（未設定の場合は認証スキップ、設計課全員で共有）
APP_PASSWORD=your-password-here

# タスク管理ページ専用の追加パスワード（呉さん本人のみ知っている値にすること）
# 未設定の場合、タスク管理ページはエラー表示になり誰も見られない
OWNER_APP_PASSWORD=your-personal-password-here

# Google Sheets連携（社内サーバー運用時に設定）
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXXXXXX/edit

# BPM自動化スプレッドシートID（案件管理・プロポイント、設計課で共有）
BPM_SHEET_ID=12BWPHfcVZiiP7ODwNz5xd0RXaNWcYL3Z5304eLgERsI

# タスク管理専用スプレッドシートID（呉さん個人用、マイドライブ・共有なし）
# サービスアカウント（gcp_service_account の client_email）をこのシートにも編集者として共有すること
